# Preferred: OpenRouter free vision model
AI_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-4-26b-a4b-it:free
OPENROUTER_SITE_URL=https://github.com/PratikBansod95/palm_reader
OPENROUTER_APP_NAME=Palm Destiny

# Optional alternatives
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-nano

PORT=8080
# Leave empty for local Flutter web defaults, or set comma-separated exact origins for production
CORS_ORIGIN=
OPENAI_TIMEOUT_MS=60000
APP_API_KEY=replace-with-strong-random-token
RATE_LIMIT_PER_MIN=120
PALM_RATE_LIMIT_PER_MIN=20
