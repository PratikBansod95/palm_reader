# Preferred free-tier provider
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Optional OpenAI fallback
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-nano

# gemini | openai (auto-selects from available keys when unset)
AI_PROVIDER=

PORT=8080
# Leave empty for local Flutter web defaults, or set comma-separated exact origins for production
CORS_ORIGIN=
OPENAI_TIMEOUT_MS=45000
APP_API_KEY=replace-with-strong-random-token
RATE_LIMIT_PER_MIN=120
PALM_RATE_LIMIT_PER_MIN=20
